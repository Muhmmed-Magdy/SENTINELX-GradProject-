# AI SOC Dashboard - Example environment file
# Copy to .env and fill in real values. Never commit real secrets.

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=<replace-with-random-64-char-hex-from: python -c "import secrets; print(secrets.token_hex(32))">
APP_ENV=development
FLASK_DEBUG=false
DEMO_MODE=false

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Log ingestion key (single-key mode) ──────────────────────────────────────
# Used by forwarder agents. Generate via: Dashboard → Settings → Ingest Keys
# Or set here as a convenience single key (DB keys take precedence when set).
# INGEST_KEY=soc-<replace-with-generated-ingest-key>

# ── Initial admin bootstrap (used ONCE; clear after first login) ──────────────
# Only takes effect when the users table is empty.
# Must be at least 12 characters.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=<replace-with-strong-password-at-least-12-chars>

# ── Database path ─────────────────────────────────────────────────────────────
# DATABASE_PATH=backend/soc_dashboard.db

# ── CORS (comma-separated origins for production) ─────────────────────────────
# CORS_ORIGINS=https://yourdomain.com,https://soc.yourdomain.com
